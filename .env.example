# 复制为 .env 并填写真实值（.env 已被 gitignore，切勿提交密钥）

# DeepSeek 密钥（必填，否则 agent 调用失败）
DEEPSEEK_API_KEY=sk-your-key-here

# 后端
SUKI_CHAT_LISTEN_ADDR=:8182
SUKI_CHAT_JWT_SECRET=change-me-in-production

# 上游模型
SUKI_CHAT_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
SUKI_CHAT_DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 会话沙箱
SUKI_CHAT_SANDBOX_MODE=docker
SUKI_CHAT_SANDBOX_IMAGE=alpine:3
SUKI_CHAT_SANDBOX_NETWORK=bridge

# 配额与管理员
SUKI_CHAT_DEFAULT_QUOTA_TOKENS=1000000
SUKI_CHAT_ADMIN_EMAIL=admin@example.com
SUKI_CHAT_ADMIN_PASSWORD=admin12345
