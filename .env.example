# 复制为 .env 并填写真实值（.env 已被 gitignore，切勿提交密钥）

# DeepSeek 密钥（必填，否则模型调用失败）
DEEPSEEK_API_KEY=sk-your-key-here

# 后端
SUKI_CHAT_LISTEN_ADDR=:8182
SUKI_CHAT_JWT_SECRET=change-me-in-production

# 上游模型
SUKI_CHAT_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
SUKI_CHAT_DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# 会话容器编排
SUKI_CHAT_SANDBOX_MODE=docker
SUKI_CHAT_RUNNER_IMAGE=suki-runner:dev          # 需先 docker build -t suki-runner:dev ./runner
SUKI_CHAT_BROWSER_IMAGE=cloakhq/cloakbrowser:latest
SUKI_CHAT_EGRESS_IMAGE=suki-egress:dev          # 需先 docker build -f Dockerfile.egress -t suki-egress:dev .
SUKI_CHAT_SANDBOX_NETWORK=suki-net              # internal 私有网；唯一出口是出网代理
SUKI_CHAT_CONTROL_URL=http://host.docker.internal:8182  # 容器回连控制平面地址
SUKI_CHAT_IDLE_TIMEOUT=15m                       # 空闲多久回收容器

# 持久化（基础设施，独立运行；控制平面只作客户端连接，不创建/管理该容器）。
# 留空则用内存存储（重启丢失）。例：
# docker run -d --name suki-pg -e POSTGRES_USER=suki -e POSTGRES_PASSWORD=suki -e POSTGRES_DB=suki -p 5433:5432 postgres:18-alpine
# SUKI_CHAT_DATABASE_DSN=postgres://suki:suki@localhost:5433/suki?sslmode=disable

# 配额与管理员
SUKI_CHAT_DEFAULT_QUOTA_TOKENS=1000000
SUKI_CHAT_ADMIN_EMAIL=admin@example.com
SUKI_CHAT_ADMIN_PASSWORD=admin12345
